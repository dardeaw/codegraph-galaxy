{
  "name": "codegraph-galaxy",
  "version": "1.0.4",
  "description": "A breathtaking interactive 3D/Galaxy visualizer and code intelligence suite for CodeGraph databases.",
  "main": "electron/main.js",
  "bin": {
    "codegraph-galaxy": "./bin/cli.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win --mac --linux",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "codegraph",
    "ast",
    "visualization",
    "3d",
    "threejs",
    "topology",
    "architecture",
    "electron"
  ],
  "author": "Chunghsing Tech / CodeGraph Team",
  "license": "MIT",
  "dependencies": {
    "@colbymchenry/codegraph": "1.6.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.codegraph.galaxy",
    "productName": "Code Graph Galaxy",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "app.py",
      "codegraph_galaxy/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app.py",
        "to": "app.py"
      },
      {
        "from": "codegraph_galaxy",
        "to": "codegraph_galaxy"
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Code Graph Galaxy"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "assets/icon.png"
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "synopsis": "Interactive 3D Galaxy visualization for CodeGraph",
      "description": "Explore codebases as a 3D Galaxy network with semantic call graphs.",
      "icon": "assets/icon.png"
    },
    "asar": true,
    "asarUnpack": [
      "app.py",
      "codegraph_galaxy/**/*",
      "assets/**/*",
      "node_modules/@colbymchenry/**/*",
      "node_modules/.bin/*"
    ],
    "icon": "assets/icon.png"
  },
  "productName": "Code Graph Galaxy"
}